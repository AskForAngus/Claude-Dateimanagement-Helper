<UserControl x:Class="NasZentrale.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Benutzer/Gruppen -->
        <DockPanel Margin="16,18,12,12">
            <TextBlock DockPanel.Dock="Top" Text="Wer darf wo?" Style="{StaticResource PageTitle}" />
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,4,0,12"
                       Text="Wähle einen Benutzer oder eine Gruppe – rechts siehst du alle Ordner und den Zugriff." />
            <ui:TextBox DockPanel.Dock="Top" x:Name="SearchBox" PlaceholderText="Benutzer oder Gruppe suchen"
                        Icon="{ui:SymbolIcon Search24}" TextChanged="SearchBox_TextChanged" Margin="0,0,0,8" />
            <ui:Button DockPanel.Dock="Top" x:Name="AllFoldersButton" Content="Ordner mit eigenen Rechten"
                       Icon="{ui:SymbolIcon ShieldCheckmark24}" Appearance="Transparent" HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="AllFolders_Click" />
            <ListBox x:Name="PrincipalList" SelectionChanged="PrincipalList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Principal.Display}" Style="{StaticResource Strong}" />
                                <TextBlock Text="{Binding Principal.KindLabel}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <!-- Ergebnis -->
        <DockPanel Grid.Column="2" Margin="20,18,16,12">
            <DockPanel DockPanel.Dock="Top">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock x:Name="IndexInfo" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="NoWrap" />
                    <ui:Button x:Name="ScanButton" Content="Rechte einlesen" Icon="{ui:SymbolIcon ArrowSync24}" Click="Scan_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="ResultTitle" Text="Ordner mit eigenen Rechten" Style="{StaticResource SectionTitle}" FontSize="20" />
                    <TextBlock x:Name="ResultHint" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
            <CheckBox DockPanel.Dock="Top" x:Name="OnlyAccessBox" Content="Nur Ordner anzeigen, auf die Zugriff besteht" Margin="0,12,0,0"
                      IsChecked="True" Visibility="Collapsed" Click="OnlyAccess_Click" />
            <ui:InfoBar DockPanel.Dock="Top" x:Name="StaleBar" Severity="Informational" IsClosable="True" IsOpen="False" Margin="0,12,0,0"
                        Title="Rechte wurden geändert" Message="Seit dem Einlesen wurden Rechte geändert. Für eine aktuelle Übersicht bitte neu einlesen." />

            <Grid Margin="0,12,0,0">
                <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="None" SelectionMode="Single" Background="Transparent" BorderThickness="0"
                          RowHeaderWidth="0" MouseDoubleClick="ResultGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Ordner" Width="2*" SortMemberPath="SortKey">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,0">
                                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Dataset}" Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Folder}" Margin="4,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="AccessColumn" Header="Zugriff" Width="150" SortMemberPath="LevelSort">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}" Background="{Binding ChipBrush}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding LevelText}" Style="{StaticResource ChipText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="DetailColumn" Header="Über" Binding="{Binding Detail}" Width="3*" ElementStyle="{StaticResource CellText}" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="NoIndexPanel" Style="{StaticResource EmptyState}">
                    <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="44" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Noch keine Übersicht" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" FontSize="13"
                               Text="Dafür werden einmal die Rechte aller Ordner gelesen. Das dauert je nach Größe einige Sekunden bis wenige Minuten." />
                    <ui:Button Content="Rechte jetzt einlesen" Appearance="Primary" HorizontalAlignment="Center" Margin="0,14,0,0"
                               Icon="{ui:SymbolIcon ArrowSync24}" Click="Scan_Click" />
                </StackPanel>
                <StackPanel x:Name="ScanningPanel" Style="{StaticResource EmptyState}" Visibility="Collapsed">
                    <ui:ProgressRing IsIndeterminate="True" />
                    <TextBlock x:Name="ScanText" Style="{StaticResource Hint}" FontSize="13" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <ui:Button Content="Abbrechen" HorizontalAlignment="Center" Margin="0,12,0,0" Click="CancelScan_Click" />
                </StackPanel>
                <TextBlock x:Name="NoRowsText" Style="{StaticResource Hint}" FontSize="13" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
