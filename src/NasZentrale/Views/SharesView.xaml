<UserControl x:Class="NasZentrale.Views.SharesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="1100" HorizontalAlignment="Stretch">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Neues Dataset" Icon="{ui:SymbolIcon DatabasePerson24}" Margin="0,0,8,0" Click="NewDataset_Click"
                               ToolTip="Neuen Speicherbereich auf dem NAS anlegen (optimiert für Windows-Freigaben)" />
                    <ui:Button Content="Neue Freigabe" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Click="NewShare_Click" />
                    <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" Appearance="Transparent" Margin="6,0,0,0" ToolTip="Aktualisieren" Click="Refresh_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Freigaben" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Windows-Netzwerkfreigaben (SMB) und die Datasets, in denen sie liegen." Style="{StaticResource Hint}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <ItemsControl x:Name="ShareList" Margin="0,20,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Panel}" Padding="16,14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Server24" FontSize="26" Margin="0,0,14,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}" FontSize="15" Margin="0,0,10,0" />
                                        <Border Style="{StaticResource ChipSuccess}" Visibility="{Binding Enabled, Converter={StaticResource Visible}}">
                                            <TextBlock Text="Aktiv" Style="{StaticResource ChipText}" />
                                        </Border>
                                        <Border Style="{StaticResource ChipWarning}" Visibility="{Binding Enabled, Converter={StaticResource Hidden}}">
                                            <TextBlock Text="Deaktiviert" Style="{StaticResource ChipText}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Visibility="{Binding ReadOnly, Converter={StaticResource Visible}}">
                                            <TextBlock Text="Schreibgeschützt" Style="{StaticResource ChipText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Unc}" Margin="0,3,0,0" />
                                    <TextBlock Style="{StaticResource Hint}">
                                        <Run Text="{Binding Path, Mode=OneWay}" /><Run Text="{Binding CommentSuffix, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Content="Ordner öffnen" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,6,0" Tag="{Binding}" Click="OpenFolder_Click"
                                               ToolTip="Dateien und Ordnerrechte dieser Freigabe anzeigen" />
                                    <ui:Button Content="Freigabeberechtigungen" Icon="{ui:SymbolIcon ShieldPerson20}" Margin="0,0,6,0" Tag="{Binding}" Click="ShareAcl_Click"
                                               ToolTip="Wer darf die Freigabe im Netzwerk überhaupt verwenden?" />
                                    <ui:Button Icon="{ui:SymbolIcon Edit24}" Margin="0,0,6,0" Tag="{Binding}" Click="Edit_Click" ToolTip="Bearbeiten" />
                                    <ui:Button Icon="{ui:SymbolIcon Delete24}" Tag="{Binding}" Click="Delete_Click" ToolTip="Freigabe entfernen (Daten bleiben erhalten)" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoShares" Text="Noch keine Freigaben vorhanden." Style="{StaticResource Hint}" Visibility="Collapsed" Margin="0,8" />

            <TextBlock Text="Datasets" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
            <ItemsControl x:Name="DatasetList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Panel}" Padding="16,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Database24" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}" Margin="0,0,10,0" />
                                        <Border Style="{StaticResource ChipWarning}" Visibility="{Binding WindowsReady, Converter={StaticResource Hidden}}"
                                                ToolTip="Keine NFSv4-ACLs – Windows-Rechte sind hier nicht möglich.">
                                            <TextBlock Text="Keine Windows-Rechte" Style="{StaticResource ChipText}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Visibility="{Binding Shared, Converter={StaticResource Hidden}}">
                                            <TextBlock Text="Nicht freigegeben" Style="{StaticResource ChipText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Mountpoint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0">
                                    <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="4" />
                                    <TextBlock Text="{Binding UsageText}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <ui:Button Content="Freigeben" Icon="{ui:SymbolIcon Share24}" Margin="0,0,6,0" Tag="{Binding}" Click="ShareDataset_Click"
                                               Visibility="{Binding Shared, Converter={StaticResource Hidden}}" ToolTip="Als Windows-Freigabe im Netzwerk bereitstellen" />
                                    <ui:Button Content="Öffnen" Icon="{ui:SymbolIcon FolderOpen24}" Tag="{Binding}" Click="OpenDataset_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
