<ui:FluentWindow x:Class="NasZentrale.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="NAS-Zentrale" Width="1480" Height="900" MinWidth="1120" MinHeight="660"
                 WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Title="NAS-Zentrale" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <DockPanel Margin="12,4,8,12">
                <StackPanel DockPanel.Dock="Bottom">
                    <ListBox x:Name="FooterNav" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged" />
                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="4,8" />
                    <Grid Margin="12,4,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="PersonCircle24" FontSize="22" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UserName" Style="{StaticResource Strong}" FontSize="12" />
                            <TextBlock x:Name="HostName" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon SignOut24}" Appearance="Transparent" BorderThickness="0"
                                   ToolTip="Abmelden" Click="Logout_Click" Padding="6" />
                    </Grid>
                </StackPanel>
                <ListBox x:Name="MainNav" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged" />
            </DockPanel>

            <!-- Seiteninhalt -->
            <Border Grid.Column="1" Margin="0,0,12,12" CornerRadius="8"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <ContentControl x:Name="PageHost" Focusable="False" FocusVisualStyle="{x:Null}" />
                    <ui:InfoBar x:Name="ConnectionBar" VerticalAlignment="Top" Margin="16" IsClosable="False" IsOpen="False"
                                Severity="Warning" Title="Verbindung unterbrochen" />
                    <ui:InfoBar x:Name="ToastBar" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="16"
                                MaxWidth="520" IsOpen="False" />
                </Grid>
            </Border>
        </Grid>

        <!-- Laufender Vorgang -->
        <Border x:Name="BusyBar" Grid.Row="2" Visibility="Collapsed" Padding="16,8"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" />
                <TextBlock x:Name="BusyText" Grid.Column="1" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ui:Button x:Name="BusyCancel" Grid.Column="2" Content="Abbrechen" Click="BusyCancel_Click" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
