<UserControl x:Class="NasZentrale.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:m="clr-namespace:NasZentrale.Models"
             xmlns:v="clr-namespace:NasZentrale.Views">
    <UserControl.Resources>
        <SolidColorBrush x:Key="FolderBrush" Color="#F2B33D" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="180" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="430" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- Ordnerbaum -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="DATASETS" Style="{StaticResource Hint}" FontWeight="SemiBold" Margin="18,18,12,8" />
            <TreeView x:Name="FolderTree" Background="Transparent" BorderThickness="0" Margin="6,0,4,8"
                      SelectedItemChanged="FolderTree_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type m:FolderNode}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <ui:SymbolIcon x:Name="Icon" Symbol="{Binding Icon}" Filled="True" FontSize="16" Margin="0,0,8,0"
                                           Foreground="{StaticResource FolderBrush}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="13" Margin="6,0,0,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           ToolTip="Eigene Rechte"
                                           Visibility="{Binding HasOwnRights, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDataset}" Value="True">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>

        <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" IsHitTestVisible="False" />
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext" />

        <!-- Dateiliste -->
        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top" Margin="16,12,16,6">
                <!-- Pfadleiste -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="BackButton" Icon="{ui:SymbolIcon ArrowLeft24}" Appearance="Transparent" BorderThickness="0"
                                   Padding="7" ToolTip="Zurück (Alt+←)" Click="Back_Click" />
                        <ui:Button x:Name="UpButton" Icon="{ui:SymbolIcon ArrowUp24}" Appearance="Transparent" BorderThickness="0"
                                   Padding="7" ToolTip="Übergeordneter Ordner (Rücktaste)" Click="Up_Click" />
                    </StackPanel>
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="4,0">
                        <ItemsControl x:Name="Breadcrumb" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ChevronRight24" FontSize="12" Margin="2,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding ShowSeparator, Converter={StaticResource Visible}}" />
                                        <ui:Button Content="{Binding Name}" Tag="{Binding Path}" Appearance="Transparent"
                                                   BorderThickness="0" Padding="6,4" Click="Crumb_Click" FontSize="14" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <ui:TextBox x:Name="FilterBox" Grid.Column="2" Width="230" PlaceholderText="In diesem Ordner filtern"
                                Icon="{ui:SymbolIcon Filter24}" TextChanged="FilterBox_TextChanged" />
                </Grid>

                <!-- Werkzeugleiste: links immer, rechts nur bei Auswahl -->
                <DockPanel Margin="0,10,0,0">
                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" BorderThickness="0" Padding="10,6" Margin="0,0,2,0" Icon="{ui:SymbolIcon ArrowClockwise24}"
                               ToolTip="Aktualisieren (F5)" Click="Refresh_Click" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="NewFolderButton" Appearance="Transparent" BorderThickness="0" Padding="10,6" Margin="0,0,2,0" Icon="{ui:SymbolIcon FolderAdd24}"
                                   Content="Neuer Ordner" Click="NewFolder_Click" ToolTip="Neuen Ordner anlegen (Strg+Umschalt+N)" />
                        <ui:Button x:Name="UploadButton" Appearance="Transparent" BorderThickness="0" Padding="10,6" Margin="0,0,2,0" Icon="{ui:SymbolIcon ArrowUpload24}"
                                   Content="Hochladen" Click="Upload_Click" ToolTip="Dateien oder Ordner vom PC hochladen – oder einfach hierher ziehen">
                            <ui:Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Dateien hochladen …" Click="UploadFiles_Click" />
                                    <MenuItem Header="Ordner hochladen …" Click="UploadFolder_Click" />
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                        </ui:Button>
                        <ui:Button x:Name="PasteButton" Appearance="Transparent" BorderThickness="0" Padding="10,6" Margin="0,0,2,0" Icon="{ui:SymbolIcon ClipboardPaste24}"
                                   Content="Einfügen" Click="Paste_Click" Visibility="Collapsed" ToolTip="Einfügen (Strg+V)" />
                        <Border x:Name="SelectionTools" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0" Margin="6,4,0,4" Padding="6,0,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="OpenButton" Appearance="Transparent" BorderThickness="0" Padding="10,6" Margin="0,0,2,0" Icon="{ui:SymbolIcon Open24}"
                                           Content="Öffnen" Click="Open_Click" ToolTip="Öffnen (Enter)" />
                                <ui:Button x:Name="RenameButton" Appearance="Transparent" BorderThickness="0" Padding="10,6" Margin="0,0,2,0" Icon="{ui:SymbolIcon Rename24}"
                                           Content="Umbenennen" Click="Rename_Click" ToolTip="Umbenennen (F2)" />
                                <ui:Button Appearance="Transparent" BorderThickness="0" Padding="10,6" Margin="0,0,2,0" Icon="{ui:SymbolIcon Copy24}"
                                           Click="Copy_Click" ToolTip="Kopieren (Strg+C)" />
                                <ui:Button Appearance="Transparent" BorderThickness="0" Padding="10,6" Margin="0,0,2,0" Icon="{ui:SymbolIcon Cut24}"
                                           Click="Cut_Click" ToolTip="Ausschneiden (Strg+X)" />
                                <ui:Button Appearance="Transparent" BorderThickness="0" Padding="10,6" Margin="0,0,2,0" Icon="{ui:SymbolIcon Delete24}"
                                           Click="Delete_Click" ToolTip="Löschen (Entf)" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <ui:InfoBar x:Name="NoShareBar" DockPanel.Dock="Top" Margin="16,0,16,8" IsClosable="False" IsOpen="False" Severity="Informational"
                        Title="Nicht freigegeben"
                        Message="Dieser Ordner liegt in keiner SMB-Freigabe. Rechte lassen sich trotzdem ändern, Dateiaktionen nur in freigegebenen Ordnern." />

            <Grid Margin="8,0,8,8">
                <DataGrid x:Name="FileGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                          HeadersVisibility="Column" GridLinesVisibility="None" CanUserResizeRows="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" AllowDrop="True" Background="Transparent"
                          BorderThickness="0" RowHeaderWidth="0"
                          SelectionChanged="FileGrid_SelectionChanged" MouseDoubleClick="FileGrid_MouseDoubleClick"
                          PreviewKeyDown="FileGrid_PreviewKeyDown" Drop="FileGrid_Drop" DragOver="FileGrid_DragOver">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type m:FileItem}">
                                    <StackPanel Orientation="Horizontal" Margin="4,0">
                                        <ui:SymbolIcon x:Name="Icon" Symbol="{Binding Icon}" FontSize="18" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="13" Margin="6,0,0,0" ToolTip="Eigene Rechte"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       Visibility="{Binding HasOwnRights, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource FolderBrush}" />
                                            <Setter TargetName="Icon" Property="Filled" Value="True" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDataset}" Value="True">
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Geändert" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="140" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Typ" Binding="{Binding TypeText}" Width="120" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" SortMemberPath="SortSize" Width="90" ElementStyle="{StaticResource CellText}" />
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu x:Name="GridMenu" Opened="GridMenu_Opened">
                            <MenuItem x:Name="MenuOpen" Header="Öffnen" Click="Open_Click" InputGestureText="Enter" />
                            <MenuItem x:Name="MenuExplorer" Header="Im Windows-Explorer zeigen" Click="ShowInExplorer_Click" />
                            <Separator />
                            <MenuItem x:Name="MenuCopy" Header="Kopieren" Click="Copy_Click" InputGestureText="Strg+C" />
                            <MenuItem x:Name="MenuCut" Header="Ausschneiden" Click="Cut_Click" InputGestureText="Strg+X" />
                            <MenuItem x:Name="MenuPaste" Header="Einfügen" Click="Paste_Click" InputGestureText="Strg+V" />
                            <Separator />
                            <MenuItem x:Name="MenuRename" Header="Umbenennen" Click="Rename_Click" InputGestureText="F2" />
                            <MenuItem x:Name="MenuDelete" Header="Löschen" Click="Delete_Click" InputGestureText="Entf" />
                            <Separator />
                            <MenuItem x:Name="MenuNewFolder" Header="Neuer Ordner" Click="NewFolder_Click" />
                            <MenuItem Header="Netzwerkpfad kopieren" Click="CopyPath_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <StackPanel x:Name="EmptyFolder" Style="{StaticResource EmptyState}" Visibility="Collapsed" IsHitTestVisible="False">
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="44" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="EmptyText" Text="Dieser Ordner ist leer." Style="{StaticResource Hint}" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="Dateien hierher ziehen, um sie hochzuladen." Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="StartPanel" Style="{StaticResource EmptyState}" Visibility="Collapsed">
                    <ui:SymbolIcon Symbol="Database24" FontSize="44" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Wähle links ein Dataset." Style="{StaticResource Hint}" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
                <ui:ProgressRing x:Name="ListLoading" IsIndeterminate="True" Visibility="Collapsed" />
            </Grid>
        </DockPanel>

        <Border Grid.Column="3" Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" IsHitTestVisible="False" />
        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext" />

        <!-- Rechte -->
        <v:RightsPanel x:Name="Rights" Grid.Column="4" />
    </Grid>
</UserControl>
