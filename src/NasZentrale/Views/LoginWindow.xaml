<ui:FluentWindow x:Class="NasZentrale.Views.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="NAS-Zentrale – Anmeldung" Width="440" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="NAS-Zentrale" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="40,12,40,36">
            <Image Source="/Assets/app.png" Width="72" Height="72" Margin="0,0,0,14" />
            <TextBlock Text="NAS-Zentrale" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" />
            <TextBlock Text="Melde dich mit deinem AD-Konto an." Style="{StaticResource Hint}" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,4,0,24" />

            <TextBlock Text="NAS-Adresse" Margin="0,0,0,6" />
            <ui:TextBox x:Name="HostBox" PlaceholderText="z. B. nas.firma.local oder 192.168.1.10" Icon="{ui:SymbolIcon Server24}" />

            <TextBlock Text="Benutzername" Margin="0,14,0,6" />
            <ui:TextBox x:Name="UserBox" PlaceholderText="FIRMA\vorname.nachname" Icon="{ui:SymbolIcon Person24}" />

            <TextBlock Text="Passwort" Margin="0,14,0,6" />
            <ui:PasswordBox x:Name="PasswordBox" Icon="{ui:SymbolIcon Key24}" KeyDown="PasswordBox_KeyDown" />

            <CheckBox x:Name="RememberBox" Content="Adresse und Benutzername merken" Margin="0,14,0,0" IsChecked="True" />

            <ui:InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" Margin="0,16,0,0" IsOpen="False" />

            <ui:Button x:Name="LoginButton" Content="Anmelden" Appearance="Primary" HorizontalAlignment="Stretch"
                       Margin="0,20,0,0" Padding="0,9" Click="Login_Click" IsDefault="True" />
            <StackPanel x:Name="BusyPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed">
                <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" />
                <TextBlock x:Name="BusyText" Margin="10,0,0,0" Style="{StaticResource Hint}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
