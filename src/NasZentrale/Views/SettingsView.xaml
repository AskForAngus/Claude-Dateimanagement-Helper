<UserControl x:Class="NasZentrale.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Einstellungen" Style="{StaticResource PageTitle}" Margin="0,0,0,20" />

            <!-- Verbindung -->
            <Border Style="{StaticResource Panel}" Padding="20,16" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="Server24" FontSize="20" Margin="0,0,10,0" />
                        <TextBlock Text="Verbindung" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="NAS" Style="{StaticResource Hint}" FontSize="13" Margin="0,3" />
                        <TextBlock x:Name="HostText" Grid.Column="1" Margin="0,3" />
                        <TextBlock Grid.Row="1" Text="TrueNAS-Version" Style="{StaticResource Hint}" FontSize="13" Margin="0,3" />
                        <TextBlock x:Name="VersionText" Grid.Row="1" Grid.Column="1" Margin="0,3" />
                        <TextBlock Grid.Row="2" Text="Angemeldet als" Style="{StaticResource Hint}" FontSize="13" Margin="0,3" />
                        <TextBlock x:Name="UserText" Grid.Row="2" Grid.Column="1" Margin="0,3" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Text="Dateizugriff (SMB)" Style="{StaticResource Hint}" FontSize="13" Margin="0,3" />
                        <TextBlock x:Name="SmbText" Grid.Row="3" Grid.Column="1" Margin="0,3" />
                        <TextBlock Grid.Row="4" Text="Zertifikat" Style="{StaticResource Hint}" FontSize="13" Margin="0,3" />
                        <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,3">
                            <ui:Button x:Name="ForgetCertButton" DockPanel.Dock="Right" Content="Vergessen" Padding="8,3" Click="ForgetCert_Click"
                                       ToolTip="Beim nächsten Anmelden wird erneut nachgefragt" />
                            <TextBlock x:Name="CertText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Protokoll -->
            <Border Style="{StaticResource Panel}" Padding="20,16" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="History24" FontSize="20" Margin="0,0,10,0" />
                        <TextBlock Text="Protokoll" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <TextBlock x:Name="ProtocolText" Style="{StaticResource Body}" />
                    <TextBlock x:Name="AdminGroupText" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    <ui:Button Content="Protokollordner einrichten / ändern …" Icon="{ui:SymbolIcon FolderPeople24}" Margin="0,12,0,0"
                               Click="SetupProtocol_Click" />
                </StackPanel>
            </Border>

            <!-- Tastenkürzel -->
            <Border Style="{StaticResource Panel}" Padding="20,16" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="Keyboard24" FontSize="20" Margin="0,0,10,0" />
                        <TextBlock Text="Tastenkürzel in der Dateiliste" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Body}" FontSize="13" LineHeight="22"
                               Text="Enter – Öffnen  ·  F2 – Umbenennen  ·  Entf – Löschen  ·  F5 – Aktualisieren&#10;Strg+C / Strg+X / Strg+V – Kopieren / Ausschneiden / Einfügen&#10;Rücktaste – Übergeordneter Ordner  ·  Alt+← – Zurück  ·  Strg+Umschalt+N – Neuer Ordner&#10;Dateien aus dem Windows-Explorer in die Liste ziehen – Hochladen" />
                </StackPanel>
            </Border>

            <!-- Über -->
            <Border Style="{StaticResource Panel}" Padding="20,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="Info24" FontSize="20" Margin="0,0,10,0" />
                        <TextBlock Text="Über NAS-Zentrale" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <TextBlock x:Name="AboutText" Style="{StaticResource Body}" FontSize="13" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Einstellungen dieses PCs liegen unter %APPDATA%\NAS-Zentrale. Passwörter werden nicht gespeichert." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
