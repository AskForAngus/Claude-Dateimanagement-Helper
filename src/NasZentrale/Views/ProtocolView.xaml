<UserControl x:Class="NasZentrale.Views.ProtocolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <DockPanel Margin="28,20,28,12">
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBox x:Name="SearchBox" Width="240" PlaceholderText="Suchen (Ordner, Name, Admin …)" Icon="{ui:SymbolIcon Search24}"
                            TextChanged="Filter_Changed" />
                <ComboBox x:Name="CategoryBox" Width="150" Margin="8,0,0,0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Alle" IsSelected="True" />
                    <ComboBoxItem Content="Rechte" />
                    <ComboBoxItem Content="Dateien" />
                    <ComboBoxItem Content="Freigaben" />
                    <ComboBoxItem Content="Datasets" />
                </ComboBox>
                <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" Appearance="Transparent" Margin="6,0,0,0" ToolTip="Aktualisieren" Click="Refresh_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Protokoll" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SubTitle" Style="{StaticResource Hint}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid DockPanel.Dock="Top" x:Name="LocalPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <ui:InfoBar x:Name="LocalBar" Severity="Warning" IsClosable="False" IsOpen="True" Title="Nur lokales Protokoll" Padding="0,0,170,0" />
            <ui:Button Content="Jetzt einrichten" Appearance="Primary" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,16,0" Click="Setup_Click" />
        </Grid>

        <Grid Margin="0,14,0,0">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl x:Name="EntryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Panel}" Padding="16,12" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="22" Margin="0,2,14,0" VerticalAlignment="Top"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Strong}" MaxWidth="700" />
                                                <Border Style="{StaticResource ChipWarning}" Margin="8,0,0,0"
                                                        Visibility="{Binding IsUndone, Converter={StaticResource Visible}}">
                                                    <TextBlock Text="Rückgängig gemacht" Style="{StaticResource ChipText}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Target}" Style="{StaticResource Hint}" />
                                            <Expander Header="Details" Margin="0,6,0,0" Padding="0"
                                                      Visibility="{Binding HasDetails, Converter={StaticResource Visible}}">
                                                <TextBlock Text="{Binding DetailsText}" Style="{StaticResource Body}" FontSize="12" Margin="4,6,0,0" />
                                            </Expander>
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Content="Rückgängig" Icon="{ui:SymbolIcon ArrowUndo24}" VerticalAlignment="Top"
                                                   Tag="{Binding}" Click="Undo_Click"
                                                   Visibility="{Binding CanUndo, Converter={StaticResource Visible}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button x:Name="MoreButton" Content="Ältere Einträge anzeigen" HorizontalAlignment="Center" Margin="0,8"
                               Click="More_Click" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel x:Name="EmptyPanel" Style="{StaticResource EmptyState}" Visibility="Collapsed">
                <ui:SymbolIcon Symbol="History24" FontSize="44" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="EmptyText" Text="Noch keine Einträge." Style="{StaticResource Hint}" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
            <ui:ProgressRing x:Name="Loading" IsIndeterminate="True" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</UserControl>
