<ui:FluentWindow x:Class="NasZentrale.Dialogs.PrincipalPickerDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="520" Height="620" ResizeMode="CanResize" MinHeight="400"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBar" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,10">
            <TextBlock x:Name="Heading" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
            <ui:TextBox x:Name="SearchBox" PlaceholderText="Name suchen …" Icon="{ui:SymbolIcon Search24}"
                        TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
            <StackPanel x:Name="KindFilter" Orientation="Horizontal" Margin="0,10,0,0">
                <RadioButton x:Name="KindAll" Content="Alle" IsChecked="True" GroupName="kind" Margin="0,0,14,0" Checked="Kind_Checked" />
                <RadioButton x:Name="KindUsers" Content="Benutzer" GroupName="kind" Margin="0,0,14,0" Checked="Kind_Checked" />
                <RadioButton x:Name="KindGroups" Content="Gruppen" GroupName="kind" Checked="Kind_Checked" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" Margin="24,0,24,12">
            <ListBox x:Name="List" MouseDoubleClick="List_MouseDoubleClick" SelectionChanged="List_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Principal.Display}" Style="{StaticResource Strong}" />
                                <TextBlock Text="{Binding Principal.KindLabel}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="NoResult" Style="{StaticResource EmptyState}" Visibility="Collapsed">
                <TextBlock Text="Nichts gefunden." Style="{StaticResource Hint}" HorizontalAlignment="Center" FontSize="13" />
                <ui:Button x:Name="ResolveButton" Margin="0,10,0,0" HorizontalAlignment="Center" Click="Resolve_Click"
                           Icon="{ui:SymbolIcon PersonSearch24}" />
                <TextBlock Text="Tipp: Neue AD-Benutzer erscheinen erst, wenn TrueNAS seinen Verzeichnis-Cache aktualisiert hat. Über die Schaltfläche wird direkt im AD gesucht."
                           Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource LayerFillColorDefaultBrush}" Padding="24,14"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" x:Name="OkButton" Content="Auswählen" MinWidth="110" Appearance="Primary"
                           IsEnabled="False" IsDefault="True" Click="Ok_Click" />
                <ui:Button DockPanel.Dock="Right" Content="Abbrechen" Margin="0,0,8,0" MinWidth="110" IsCancel="True" />
                <ui:Button Content="Liste neu laden" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowSync24}"
                           HorizontalAlignment="Left" Click="Reload_Click" ToolTip="Benutzer und Gruppen erneut vom NAS laden" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
