<ui:FluentWindow x:Class="NasZentrale.Dialogs.AclPreviewDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Änderungen prüfen" Width="600" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Änderungen prüfen" ShowMinimize="False" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,4,24,20">
                <TextBlock x:Name="Heading" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                <TextBlock x:Name="PathText" Style="{StaticResource Hint}" Margin="0,2,0,16" />

                <TextBlock Text="Das ändert sich" Style="{StaticResource Hint}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ItemsControl x:Name="ChangeList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="{Binding Icon}" Foreground="{Binding Brush}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Body}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Auswirkung" Style="{StaticResource Hint}" FontWeight="SemiBold" Margin="0,18,0,6" />
                <Border Style="{StaticResource Panel}" Padding="14,12">
                    <StackPanel>
                        <StackPanel x:Name="ScanBusy" Orientation="Horizontal" Visibility="Collapsed">
                            <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" />
                            <TextBlock x:Name="ScanText" Margin="10,0,0,0" VerticalAlignment="Center" Text="Unterordner werden geprüft …" />
                        </StackPanel>
                        <TextBlock x:Name="EffectText" Style="{StaticResource Body}" />
                        <StackPanel x:Name="CustomPanel" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock x:Name="CustomTitle" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <ItemsControl x:Name="CustomList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="14" Margin="0,0,6,0"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding}" Style="{StaticResource Hint}" FontSize="13" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock x:Name="NoteText" Style="{StaticResource Hint}" Margin="0,10,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Die Änderung wird protokolliert und kann im Protokoll rückgängig gemacht werden."
                           Style="{StaticResource Hint}" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource LayerFillColorDefaultBrush}" Padding="24,14"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Abbrechen" Margin="0,0,8,0" MinWidth="110" Click="Cancel_Click" />
                <ui:Button x:Name="ApplyButton" Content="Jetzt anwenden" MinWidth="130" Appearance="Primary" IsEnabled="False"
                           Click="Apply_Click" Icon="{ui:SymbolIcon Checkmark24}" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
